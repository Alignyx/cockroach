# Regression #151609: choose the first lateral row before applying ON.
exec-ddl
CREATE TABLE la (k INT PRIMARY KEY, x INT)
----

exec-ddl
CREATE TABLE lb (k INT PRIMARY KEY, x INT)
----

# A join filter cannot move below LIMIT 1.
norm expect-not=TryDecorrelateLimitOne
SELECT a.k, b.k FROM la a LEFT JOIN LATERAL (
  SELECT k FROM lb WHERE x < a.x ORDER BY x DESC LIMIT 1
) b ON b.k = a.k
----
